# ===========================================
# Church Website - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# Run: cp .env.example .env

# -------------------------------------------
# Application Settings
# -------------------------------------------
APP_NAME=Our Church

# -------------------------------------------
# MongoDB Configuration
# -------------------------------------------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here

# -------------------------------------------
# Auth0 Configuration
# -------------------------------------------
#
# STEP 1: Create an Application in Auth0
#   - Go to: https://manage.auth0.com/
#   - Navigate to: Applications > Applications > + Create Application
#   - Type: Single Page Application
#   - Name: Church Website
#
# STEP 2: Configure Application Settings
#   In your Application > Settings, add these URLs:
#   - Allowed Callback URLs: http://localhost:3000, http://localhost:3000/callback
#   - Allowed Logout URLs: http://localhost:3000
#   - Allowed Web Origins: http://localhost:3000
#   - Allowed Origins (CORS): http://localhost:3000
#
# STEP 3: Get these values from Application > Settings:
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id_here
AUTH0_CLIENT_SECRET=your_client_secret_here

# STEP 4: Create an API in Auth0
#   - Go to: Applications > APIs > + Create API
#   - Name: Church API
#   - Identifier: https://church-api (you can use any unique string)
#
# STEP 5: Copy the API Identifier here:
AUTH0_AUDIENCE=https://church-api

# -------------------------------------------
# JWT Configuration
# -------------------------------------------
# Used for internal token signing (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# -------------------------------------------
# URLs (for local development / Docker)
# -------------------------------------------
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000/api/v1

# -------------------------------------------
# Email Configuration (SMTP) - Optional
# -------------------------------------------
# For sending emails (contact form, notifications, etc.)
# You can leave these empty for development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# -------------------------------------------
# Mongo Express (Admin UI) - Optional
# -------------------------------------------
# Used when running with: docker-compose --profile admin up -d
# Access at: http://localhost:8081
MONGOEXPRESS_USERNAME=admin
MONGOEXPRESS_PASSWORD=admin123
